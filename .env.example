# Copy to .env (never commit .env). All values optional except where noted.
# development | production. Production refuses non-Azure narration.
STUDIO_MODE=development
STUDIO_DATA_DIR=./data
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8765
# Azure AI Speech (required for production narration)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Cost control: max characters sent to TTS per project (all runs combined)
STUDIO_MAX_TTS_CHARS_PER_PROJECT=20000
# Optional: explicit Chromium binary for Playwright
STUDIO_CHROMIUM_EXECUTABLE=
